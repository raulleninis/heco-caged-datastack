{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.old)",
      "Read(./.env.bak)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(**/.env)",
      "Read(**/.env.old)",
      "Read(**/.env.bak)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Edit(./.env)",
      "Edit(./.env.old)",
      "Edit(./.env.bak)",
      "Edit(./.env.local)",
      "Edit(**/.env)",
      "Edit(**/.env.old)",
      "Edit(**/.env.bak)",
      "Edit(**/.env.local)",
      "Bash(cat *.env)",
      "Bash(cat *.env.old)",
      "Bash(cat *.env.bak)",
      "Bash(cat *.env.local)",
      "Bash(head *.env)",
      "Bash(head *.env.old)",
      "Bash(tail *.env)",
      "Bash(tail *.env.old)",
      "Bash(less *.env)",
      "Bash(more *.env)",
      "Bash(grep * .env)",
      "Bash(grep * .env.old)",
      "Bash(sed * .env)",
      "Bash(sed * .env.old)",
      "Bash(awk * .env)",
      "Bash(awk * .env.old)",
      "Bash(cp *.env *)",
      "Bash(cp *.env.old *)",
      "Bash(source *.env)",
      "Bash(. *.env)",
      "Bash(docker compose config*)",
      "Bash(docker-compose config*)",
      "Bash(printenv*)",
      "Bash(env)"
