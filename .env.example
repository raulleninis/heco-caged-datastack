# Copie para .env (`cp .env.example .env`) e ajuste o que precisar.
# Este arquivo é versionado; o .env real nunca é (veja .gitignore).

# Usuário do Postgres. Tem valor padrão ("caged") no docker-compose.yml,
# então esta linha é opcional -- mantida aqui só para ficar explícita.
POSTGRES_USER=caged

# Senha do Postgres. NÃO tem valor padrão: o compose se recusa a subir com uma
# mensagem clara se esta variável não estiver definida. Escolha uma senha sua;
# o valor abaixo é só um exemplo, não uma senha real.
POSTGRES_PASSWORD=defina-uma-senha-aqui

# IP ou hostname Tailscale usado pela UI do Prefect (PREFECT_UI_API_URL).
# Opcional: sem Tailscale, o padrão é "localhost" e a UI fica em
# http://localhost:4200. Só troque se você acessa por outra máquina.
PREFECT_HOST=localhost
