# Copie para .env (`cp .env.example .env`) e ajuste o que precisar.
# Este arquivo é versionado; o .env real nunca é (veja .gitignore).

# IP ou hostname Tailscale usado pela UI do Prefect (PREFECT_UI_API_URL).
# Opcional: sem Tailscale, o padrão é "localhost" e a UI fica em
# http://localhost:4200. Só troque se você acessa por outra máquina.
PREFECT_HOST=localhost

# Alertas (F11). Ambos opcionais — sem eles o pipeline roda igual, mas ninguém
# é avisado quando falha ou para de rodar.
#
# Tópico ntfy que recebe alertas ativos (falha, defasagem, testes em WARN,
# volume suspeito). Ex.: https://ntfy.sh/meu-topico-secreto (o nome do tópico
# é a "senha": use algo difícil de adivinhar) ou uma instância própria.
NTFY_URL=
# URL de ping de um dead-man's-switch (ex.: healthchecks.io). Recebe um ping ao
# fim de cada run bem-sucedido; o alerta vem da AUSÊNCIA do ping — o único que
# avisa se o Prefect, o container ou a máquina inteira pararem.
HEARTBEAT_URL=

# Entrega por e-mail + arquivo autenticado (F15). Tudo desligado por padrão: com
# ENTREGA_HABILITADA=false o flow diário não envia nem arquiva nada.
#
# Só ligue depois de: (1) o arquivo no Netlify passar no teste de bloqueio e
# (2) um `entrega.py teste` chegar na sua caixa. Ver README, seção "Entrega".
ENTREGA_HABILITADA=false
# Repositório PRIVADO do arquivo (deploy key em ./secrets/arquivo_deploy_key) e
# o endereço do site no Netlify (vai como link no e-mail).
ARQUIVO_REPO_URL=
ARQUIVO_BRANCH=main
ARQUIVO_SITE_URL=
# SMTP de qualquer provedor (587 = STARTTLS, 465 = TLS direto). Credencial de
# ESCOPO MÍNIMO (só envio) — D08. A porta 25 costuma estar bloqueada na Oracle.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_REMETENTE=
# Endereço (ou URL) para sair da lista; vai no cabeçalho List-Unsubscribe e no corpo.
EMAIL_SAIR_DA_LISTA=
# Para onde vão as respostas ao boletim (cabeçalho Reply-To). O remetente costuma ser um
# subdomínio sem caixa de e-mail; use uma caixa que você lê. Opcional.
EMAIL_RESPONDER_PARA=
# Destino do modo de teste (`python flows/entrega.py teste`): só você recebe.
EMAIL_TESTE=
# A lista de destinatários NÃO fica aqui nem no git: ./secrets/destinatarios.txt,
# um e-mail por linha.
