# Segredos -- nunca versionar (inclui cópias como .env.old / .env.bak)
.env
.env.*
!.env.example

# Dados -- grandes, regeneráveis pelo pipeline, não são "código"
data/

# Artefatos do dbt -- gerados a cada run, não são fonte
dbt/target/
dbt/dbt_packages/
dbt/logs/

# Python
__pycache__/
*.pyc

# Diversos
.DS_Store
dbt/.user.yml
